# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# HexaFlow B2B Lead Capture (Cloudflare Pages / Static Deploy)
# Webhook URL (Cloudflare Worker, Formspree, or Tally endpoint) receiving JSON POST submissions:
VITE_LEAD_ENDPOINT=""

# Fallback direct contact email for pre-filled mailto: handoff when VITE_LEAD_ENDPOINT is unset or offline:
VITE_CONTACT_EMAIL="contato@hexaflow.dev"

# Optional WhatsApp number (digits with country code, e.g. 5511999999999) for 1-click lead handoff:
VITE_WHATSAPP_NUMBER=""

# Optional scheduling URL (e.g. Cal.com link) shown after diagnostic submission:
VITE_BOOKING_URL=""
